PORT=3001
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Tribün <noreply@yourdomain.com>

# CORS
FRONTEND_URL=http://localhost:5173

# API-Football (api-football.com)
FOOTBALL_API_KEY=your_api_football_key_here

# Sync secret — required in request header: x-sync-secret
# Leave blank to disable auth on /api/sync routes (dev only)
SYNC_SECRET=your-sync-secret-here

# Default leagues to sync (comma-separated API-Football league IDs)
# 1 = World Cup, 4 = Euro Championship, 2 = Champions League, 39 = Premier League
DEFAULT_LEAGUE_IDS=1,4
DEFAULT_SEASON=2026
